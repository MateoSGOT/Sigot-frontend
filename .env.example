# Copiar a .env.local (que está en .gitignore) y ajustar.

# URL de la API. Si no se define, src/shared/services/api.js cae a
# http://localhost:3000 — y si ahí no hay nada corriendo, el login falla sin
# decir por qué y no se puede pasar del guardián de rutas.
#   API local:      http://localhost:3000
#   API desplegada: https://sigot-api.onrender.com  (escribe en la base REAL)
VITE_API_URL=http://localhost:3000

# Omitir la validación de sesión. SOLO desarrollo: `npm run build` elimina la
# rama del bundle porque Vite sustituye import.meta.env.DEV por false.
# Sirve para revisar el maquetado de una vista sin tener credenciales de ese
# tipo de cuenta (p. ej. /portal rechaza a los empleados).
# No inyecta usuario falso: las páginas se ven en su estado VACÍO. Mientras esté
# activo aparece una franja roja fija abajo. Ver ProtectedRoute en src/App.jsx.
# VITE_DEV_SKIP_AUTH=true
